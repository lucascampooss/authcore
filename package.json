{
  "name": "@lucascampooss/authcore",
  "version": "0.2.0",
  "description": "Framework-agnostic authentication library with JWT, refresh tokens, RBAC, and advanced session management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"examples/**/*.ts\" \"*.md\" \"*.json\"",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "refresh-token",
    "rbac",
    "authorization",
    "framework-agnostic",
    "typescript",
    "security",
    "session-management",
    "multi-device",
    "token-rotation",
    "bcrypt",
    "middleware"
  ],
  "author": {
    "name": "Lucas Campos",
    "email": "fastzaaao@gmail.com",
    "url": "https://github.com/lucascampooss"
  },
  "license": "MIT",
  "homepage": "https://github.com/lucascampooss/authcore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucascampooss/authcore.git"
  },
  "bugs": {
    "url": "https://github.com/lucascampooss/authcore/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/lucascampooss"
  },
  "sideEffects": false,
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}